# Copy to .env (or export these in your shell). All are optional for local use.

# Django secret key. Any long random string; required for anything public.
DJANGO_SECRET_KEY=change-me
# 1 = debug mode (needed for runserver to serve static files), 0 = off
DJANGO_DEBUG=1
# Comma-separated host names the server answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only used by /calendar/add_from_gc/ (superuser-only Google Calendar import)
GOOGLE_API_KEY=
GOOGLE_CALENDAR_ID=
